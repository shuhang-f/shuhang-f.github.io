---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={["site-header", { "site-header-compact": compact }]}>
  <a class="wordmark" href="/" aria-label="Shuhang Feng, home">
    <span class="wordmark-index">SF / 26</span>
    <span>Shuhang Feng</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
    Menu
  </button>

  <nav id="primary-nav" aria-label="Primary navigation">
    <a href="/#work">Work</a>
    <a href="/#experience">Experience</a>
    <a href="/resume.pdf" target="_blank" rel="noopener">Résumé ↗</a>
    <a href="/#contact">Contact</a>
  </nav>

  <a class="availability" href="/#contact"><span aria-hidden="true"></span> Open to FDE roles</a>
</header>
