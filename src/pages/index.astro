---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseVisual from "../components/CaseVisual.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { capabilityGroups, caseStudies, experience, selectedBuilds } from "../data/site";

const proof = [
  { value: "~3 weeks", label: "Functional MVP delivered for founder testing" },
  { value: "11 cases", label: "Tests for the model's first decision" },
  { value: "0 loss", label: "Critical data preserved in a production migration" },
  { value: "10+", label: "Collaborators supported across engineering tools" },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Shuhang Feng",
  url: "https://shuhang-f.github.io/",
  jobTitle: "Product Engineer",
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Southern California" },
    { "@type": "CollegeOrUniversity", name: "Northeastern University" },
  ],
  sameAs: [
    "https://github.com/shuhang-f",
    "https://www.linkedin.com/in/shuhangf",
  ],
};
---

<BaseLayout
  title="Shuhang Feng — Product Engineer"
  description="Shuhang Feng builds practical software for AI, fintech, and data products, from early user research through production."
  canonicalPath="/"
  socialImage="/og.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <SiteHeader />

  <main id="main">
    <section class="hero">
      <div class="hero-meta">
        <p>Product engineer</p>
        <p>Corona, California</p>
        <p>English / 中文</p>
      </div>

      <div class="hero-statement">
        <p class="eyebrow">Field note 01 — About</p>
        <h1>
          I turn unclear problems into
          <em>software people can use.</em>
        </h1>
        <p class="hero-lede">
          I work with users, build the product, test what can go wrong, and keep
          it working after launch.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">See selected work <span>↓</span></a>
          <a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">Read résumé <span>↗</span></a>
        </div>
      </div>

      <aside class="operating-loop" aria-labelledby="loop-title">
        <div class="loop-heading">
          <p id="loop-title">How I work</p>
          <span>01—04</span>
        </div>
        <ol>
          <li><span>01</span><strong>Understand</strong><small>Talk to the people using it</small></li>
          <li><span>02</span><strong>Build</strong><small>Make the shortest useful version</small></li>
          <li><span>03</span><strong>Test</strong><small>Check real failure cases</small></li>
          <li><span>04</span><strong>Support</strong><small>Fix what breaks in use</small></li>
        </ol>
      </aside>
    </section>

    <section class="proof-strip" aria-label="Selected evidence">
      {proof.map((item, index) => (
        <article>
          <span class="proof-index">0{index + 1}</span>
          <strong>{item.value}</strong>
          <p>{item.label}</p>
        </article>
      ))}
    </section>

    <section class="section-intro" id="work" aria-labelledby="work-title" data-reveal>
      <p class="section-index">02 / Selected work</p>
      <h2 id="work-title">Three projects.<br /><em>Built through production.</em></h2>
      <p class="section-deck">
        Each case covers the original problem, what I built, what changed, and
        where the limits are.
      </p>
    </section>

    <section class="case-list" aria-label="Featured case studies">
      {caseStudies.map((item) => (
        <article class="case-card" data-reveal>
          <div class="case-card-meta">
            <span>Case / {item.index}</span>
            <span>{item.kicker}</span>
          </div>
          <div class="case-card-copy">
            <p class="case-card-name">{item.shortTitle}</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <ul aria-label={`${item.shortTitle} disciplines`}>
              {item.disciplines.slice(0, 4).map((discipline) => <li>{discipline}</li>)}
            </ul>
            <a class="case-link" href={`/work/${item.slug}/`}>
              Read case study <span aria-hidden="true">↗</span>
            </a>
          </div>
          <CaseVisual type={item.visual} compact />
        </article>
      ))}
    </section>

    <section class="builds" aria-labelledby="builds-title">
      <div class="section-intro section-intro-compact" data-reveal>
        <p class="section-index">03 / Selected builds</p>
        <h2 id="builds-title">More things<br />I’ve built.</h2>
        <p class="section-deck">Public projects with code or a live demo you can inspect.</p>
      </div>

      <div class="build-grid">
        {selectedBuilds.map((project) => (
          <article class="build-card" data-reveal>
            <div class="build-topline"><span>{project.index}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <ul>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="build-links">
              {project.live && <a href={project.live} target="_blank" rel="noopener">Open live ↗</a>}
              {project.code && <a href={project.code} target="_blank" rel="noopener">View code ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-intro section-intro-compact" data-reveal>
        <p class="section-index">04 / Experience</p>
        <h2 id="experience-title">Work across product<br /><em>and operations.</em></h2>
        <p class="section-deck">I stay involved after the first version ships.</p>
      </div>

      <div class="experience-list">
        {experience.map((item, index) => (
          <article class="experience-row" data-reveal>
            <span class="experience-number">0{index + 1}</span>
            <p class="experience-dates">{item.dates}</p>
            <div>
              <p class="experience-company">{item.company}</p>
              <h3>{item.role}</h3>
            </div>
            <p class="experience-description">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="capability-grid" aria-label="Capabilities">
        {capabilityGroups.map((group) => (
          <article data-reveal>
            <span>{group.index}</span>
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>

      <div class="education-strip" data-reveal>
        <p><span>Education / 01</span><strong>University of Southern California</strong><small>M.S. Data Science · Aug 2025</small></p>
        <p><span>Education / 02</span><strong>Northeastern University</strong><small>B.S. Computer Science · 2018–2022</small></p>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
