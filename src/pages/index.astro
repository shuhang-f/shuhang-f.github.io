---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { experience, featuredProjects, otherProjects } from "../data/site";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Shuhang Feng",
  url: "https://shuhang-f.github.io/",
  jobTitle: "Product Engineer",
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Southern California" },
    { "@type": "CollegeOrUniversity", name: "Northeastern University" },
  ],
  sameAs: ["https://github.com/shuhang-f", "https://www.linkedin.com/in/shuhangf"],
};
---

<BaseLayout
  title="Shuhang Feng — Selected Work"
  description="Selected projects by Shuhang Feng across AI, markets, and community tools."
  canonicalPath="/"
  socialImage="/og.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <SiteHeader />

  <main id="main" class="portfolio-home">
    <section class="portfolio-hero">
      <div class="portfolio-hero-copy">
        <p class="tech-label">Product work · California · English + 中文</p>
        <h1>Hi, I’m Shuhang.</h1>
        <p class="portfolio-hero-lede">
          I’m a product engineer interested in AI, markets, and community tools.
          This site collects a few projects I’ve worked on and what I learned
          from building them.
        </p>
        <div class="portfolio-actions">
          <a class="primary-link" href="#work">View selected work <span>↓</span></a>
          <a class="quiet-link" href="https://github.com/shuhang-f" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>

      <aside class="project-index" aria-label="Featured project index">
        <div class="project-index-head"><span>Selected work</span><span>01—03</span></div>
        <ol>
          {featuredProjects.map((project) => (
            <li><span>{project.index}</span><p>{project.name}</p><small>{project.kind}</small></li>
          ))}
        </ol>
      </aside>
    </section>

    <section class="featured-work" id="work" aria-labelledby="featured-title">
      <header class="portfolio-section-head" data-reveal>
        <p class="tech-label">Featured work</p>
        <h2 id="featured-title">A few projects I’ve worked on.</h2>
        <p>
          They began for different reasons—a startup need, a personal curiosity,
          or a tool I wanted to use myself. Each taught me something about how
          software changes through use.
        </p>
      </header>

      <div class="featured-projects">
        {featuredProjects.map((project) => (
          <article class="featured-project" data-reveal>
            <div class="featured-project-copy">
              <div class="project-kicker"><span>{project.index}</span><span>{project.kind}</span></div>
              <p class="project-name">{project.name}</p>
              <h3>{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <ul class="project-facts" aria-label={`${project.name} highlights`}>
                {project.facts.map((fact) => <li>{fact}</li>)}
              </ul>
              <div class="project-links">
                {project.links.map((link) => (
                  <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener" : undefined}>
                    {link.label} <span>↗</span>
                  </a>
                ))}
              </div>
            </div>
            <ProjectVisual type={project.visual} />
          </article>
        ))}
      </div>
    </section>

    <section class="more-work" id="more-work" aria-labelledby="more-work-title">
      <header class="compact-section-head" data-reveal>
        <p class="tech-label">More work</p>
        <h2 id="more-work-title">A few more projects.</h2>
      </header>
      <div class="more-work-grid">
        {otherProjects.map((project) => (
          <article data-reveal>
            <div class="project-kicker"><span>{project.index}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a href={project.href} target={project.external ? "_blank" : undefined} rel={project.external ? "noopener" : undefined}>
              {project.label} <span>↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div>
        <p class="tech-label">About</p>
        <h2 id="about-title">A little about how I work.</h2>
      </div>
      <div class="about-copy" data-reveal>
        <p>
          My work has moved between product engineering, customer support,
          infrastructure, QA, community tools, and the occasional game
          calculator. That mix suits me: I enjoy understanding the context,
          building something useful, and learning from how it is used.
        </p>
        <p>
          Outside the polished case study, I’m usually testing a new tool,
          maintaining something self-hosted, or rebuilding an older project to
          understand how I would approach it now.
        </p>
        <ul>
          <li>AI products with visible decisions</li>
          <li>Tools that explain their output</li>
          <li>Small systems I can understand and maintain</li>
        </ul>
      </div>
    </section>

    <section class="timeline-section" id="experience" aria-labelledby="timeline-title">
      <header class="compact-section-head" data-reveal>
        <p class="tech-label">Timeline</p>
        <h2 id="timeline-title">Work and education.</h2>
        <a href="/resume.pdf" target="_blank" rel="noopener">Open full résumé ↗</a>
      </header>
      <div class="timeline-list">
        {experience.map((item) => (
          <article data-reveal>
            <p class="timeline-dates">{item.dates}</p>
            <div><span>{item.company}</span><h3>{item.role}</h3></div>
            <p>{item.description}</p>
          </article>
        ))}
        <article data-reveal>
          <p class="timeline-dates">2018 — 2025</p>
          <div><span>USC + Northeastern</span><h3>Data Science and Computer Science</h3></div>
          <p>M.S. Data Science from USC and B.S. Computer Science from Northeastern University.</p>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
