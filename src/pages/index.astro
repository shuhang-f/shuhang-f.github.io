---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import groupPortrait from "../assets/group-portrait.jpg";
import graduationWalk from "../assets/graduation-walk.png";
import assistedWorkflows from "../assets/assisted-workflows.jpg";
import BrandIcon from "../components/BrandIcon.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { experience, featuredProjects, otherProjects } from "../data/site";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Shuhang Feng",
  url: "https://shuhang-f.github.io/",
  jobTitle: "Product Engineer",
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Southern California" },
    { "@type": "CollegeOrUniversity", name: "Northeastern University" },
  ],
  sameAs: ["https://github.com/shuhang-f", "https://www.linkedin.com/in/shuhangf"],
};
---

<BaseLayout
  title="Shuhang Feng — Selected Work"
  description="Shuhang Feng builds AI, market, and community tools with clear user control and business rules enforced in code."
  canonicalPath="/"
  socialImage="/og.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <SiteHeader />

  <main id="main" class="portfolio-home">
    <section class="portfolio-hero">
      <div class="portfolio-hero-copy">
        <p class="tech-label">Product work · California · English + 中文</p>
        <h1>Hi, I’m Shuhang.</h1>
        <p class="portfolio-hero-lede">
          I’m a product engineer building AI, market, and community tools.
          I care about making complex workflows easier to use, with clear user
          control and business rules enforced in code. These projects show what
          I’ve built and what I’m learning through use.
        </p>
        <div class="portfolio-actions">
          <a class="primary-link" href="#work">View selected work <span>↓</span></a>
          <a class="quiet-link icon-link" href="https://github.com/shuhang-f" target="_blank" rel="noopener">
            <BrandIcon brand="github" />
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <aside class="project-index" aria-label="Featured project index">
        <div class="project-index-head"><span>Selected work</span><span>01—03</span></div>
        <ol>
          {featuredProjects.map((project) => (
            <li><span>{project.index}</span><p>{project.name}</p><small>{project.kind}</small></li>
          ))}
        </ol>
      </aside>
    </section>

    <section class="experiments-section" aria-labelledby="experiments-title">
      <header class="compact-section-head" data-reveal>
        <p class="tech-label">Off the clock</p>
        <h2 id="experiments-title">A little room to play.</h2>
      </header>
      <p class="experiments-intro">
        I also use AI tools to explore things I’m curious about. These Blender
        experiments turned photos into slightly awkward, very memorable 3D scenes.
      </p>
      <div class="experiments-grid">
        <figure data-reveal>
          <Image
            src={groupPortrait}
            alt="A playful 3D group portrait with oversized glasses, expressive faces, and peace signs."
            widths={[480, 800, 1200, 1400]}
            sizes="(max-width: 680px) 100vw, 50vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span>01 / Blender experiment</span>
            <h3>A group photo, rebuilt in 3D.</h3>
            <p>Exploring faces, materials, and warm lighting. The oversized glasses have a personality of their own.</p>
          </figcaption>
        </figure>
        <figure data-reveal>
          <Image
            src={graduationWalk}
            alt="Four stylized graduates in black gowns walking in bright sunlight beside a brick wall and green shutter."
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 680px) 100vw, 50vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span>02 / Blender experiment</span>
            <h3>Graduation in the afternoon sun.</h3>
            <p>Working through poses, gown shapes, and sunlight to bring a moment back as an editable scene.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div>
        <p class="tech-label">About</p>
        <h2 id="about-title">A little about how I work.</h2>
        <figure class="about-illustration" data-reveal>
          <Image
            src={assistedWorkflows}
            alt="A hand-drawn illustration of an overwhelmed phone operator and a robot coordinating calls with human support, review, and scheduling."
            widths={[480, 800, 1200]}
            sizes="(max-width: 680px) 100vw, 40vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Exploring how AI can handle routine coordination while people stay involved.</figcaption>
        </figure>
      </div>
      <div class="about-copy" data-reveal>
        <p>
          My work has moved between product engineering, customer support,
          infrastructure, QA, and community tools. I enjoy understanding the
          context, building something useful, and learning from how people use it.
        </p>
        <p>
          Building and exploring AI tools has sharpened how I think about the
          products I want to make:
        </p>
        <ul>
          <li>Design for gradual adoption, and describe capabilities precisely.</li>
          <li>Offer structured choices, room for a different answer, and an explicit option to let the AI choose.</li>
          <li>Make intermediate results easy to inspect, with opportunities to edit, approve, or stop the work.</li>
          <li>Use AI for language and flexible interaction while code enforces business rules, permissions, and sensitive boundaries.</li>
        </ul>
        <p>
          Outside these projects, I’m usually testing a new tool, maintaining
          something self-hosted, or rebuilding an older project to understand
          how I would approach it now.
        </p>
      </div>
    </section>

    <section class="featured-work" id="work" aria-labelledby="featured-title">
      <header class="portfolio-section-head" data-reveal>
        <p class="tech-label">Featured work</p>
        <h2 id="featured-title">A few projects I’ve worked on.</h2>
        <p>
          They began for different reasons—a startup need, a personal curiosity,
          or a tool I wanted to use myself. Each taught me something about how
          software changes through use.
        </p>
      </header>

      <div class="featured-projects">
        {featuredProjects.map((project) => (
          <article class="featured-project" data-reveal>
            <div class="featured-project-copy">
              <div class="project-kicker"><span>{project.index}</span><span>{project.kind}</span></div>
              <p class="project-name">{project.name}</p>
              <h3>{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <ul class="project-facts" aria-label={`${project.name} highlights`}>
                {project.facts.map((fact) => <li>{fact}</li>)}
              </ul>
              <div class="project-links">
                {project.links.map((link) => (
                  <a class:list={{ "icon-link": link.href.startsWith("https://github.com/") }} href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener" : undefined}>
                    {link.href.startsWith("https://github.com/") && <BrandIcon brand="github" />}
                    <span>{link.label}</span>
                    {!link.href.startsWith("https://github.com/") && <span aria-hidden="true">↗</span>}
                  </a>
                ))}
              </div>
            </div>
            <ProjectVisual type={project.visual} />
          </article>
        ))}
      </div>
    </section>

    <section class="more-work" id="more-work" aria-labelledby="more-work-title">
      <header class="compact-section-head" data-reveal>
        <p class="tech-label">More work</p>
        <h2 id="more-work-title">A few more projects.</h2>
      </header>
      <div class="more-work-grid">
        {otherProjects.map((project) => (
          <article data-reveal>
            <div class="project-kicker"><span>{project.index}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a class:list={{ "icon-link": project.href.startsWith("https://github.com/") }} href={project.href} target={project.external ? "_blank" : undefined} rel={project.external ? "noopener" : undefined}>
              {project.href.startsWith("https://github.com/") && <BrandIcon brand="github" />}
              <span>{project.label}</span>
              {!project.href.startsWith("https://github.com/") && <span aria-hidden="true">↗</span>}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="timeline-section" id="experience" aria-labelledby="timeline-title">
      <header class="compact-section-head" data-reveal>
        <p class="tech-label">Timeline</p>
        <h2 id="timeline-title">Work and education.</h2>
        <a href="/resume.pdf" target="_blank" rel="noopener">Open full résumé ↗</a>
      </header>
      <div class="timeline-list">
        {experience.map((item) => (
          <article data-reveal>
            <p class="timeline-dates">{item.dates}</p>
            <div><span>{item.company}</span><h3>{item.role}</h3></div>
            <p>{item.description}</p>
          </article>
        ))}
        <article data-reveal>
          <p class="timeline-dates">2018 — 2025</p>
          <div><span>USC + Northeastern</span><h3>Data Science and Computer Science</h3></div>
          <p>M.S. Data Science from USC and B.S. Computer Science from Northeastern University.</p>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
