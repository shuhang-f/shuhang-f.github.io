---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseVisual from "../../components/CaseVisual.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { caseStudies, type CaseStudy } from "../../data/site";

export function getStaticPaths() {
  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const currentIndex = caseStudies.findIndex((item) => item.slug === caseStudy.slug);
const nextCase = caseStudies[(currentIndex + 1) % caseStudies.length];

const sections = [
  "context",
  "response",
  ...(caseStudy.screens ? ["screens"] : []),
  ...(caseStudy.comparison ? ["comparison"] : []),
  "results",
  ...(caseStudy.reflection ? ["reflection"] : []),
];
const sectionNumber = (key: string) => String(sections.indexOf(key) + 1).padStart(2, "0");
---

<BaseLayout
  title={`${caseStudy.shortTitle} — Shuhang Feng`}
  description={caseStudy.summary}
  canonicalPath={`/work/${caseStudy.slug}/`}
  socialImage={null}
>
  <SiteHeader compact />

  <main id="main" class="case-page">
    <div class="case-breadcrumb">
      <a href="/#work">← Selected work</a>
      <span>Case study / {caseStudy.index}</span>
    </div>

    <section class="case-hero" aria-labelledby="case-title">
      <div class="case-hero-index">{caseStudy.index}</div>
      <div class="case-hero-copy">
        <p class="eyebrow">{caseStudy.kicker}</p>
        <p class="case-hero-name">{caseStudy.shortTitle}</p>
        <h1 id="case-title">{caseStudy.title}</h1>
        <p class="case-hero-summary">{caseStudy.summary}</p>
      </div>
      <aside class="case-hero-rail">
        <p><span>Status</span><strong>{caseStudy.timeframe}</strong></p>
        <p><span>Role</span><strong>{caseStudy.role}</strong></p>
        <div>
          <span>Disciplines</span>
          <ul>{caseStudy.disciplines.map((item) => <li>{item}</li>)}</ul>
        </div>
      </aside>
    </section>

    <section class="case-proof" aria-label="Case evidence">
      {caseStudy.proof.map((item, index) => (
        <article>
          <span>0{index + 1}</span>
          <strong>{item.value}</strong>
          <p>{item.label}</p>
        </article>
      ))}
    </section>

    <section class="case-visual-section" data-reveal>
      <div class="case-section-label"><span>Diagram</span><span>Not to scale</span></div>
      <CaseVisual type={caseStudy.visual} />
    </section>

    <section class="case-narrative" aria-labelledby="problem-title" data-reveal>
      <div class="case-section-label"><span>{sectionNumber("context")} / Context</span><span>The problem</span></div>
      <h2 id="problem-title">Where I started.</h2>
      <div class="case-prose">
        {caseStudy.problem.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="case-response" aria-labelledby="response-title">
      <div class="case-section-label"><span>{sectionNumber("response")} / Response</span><span>What I did</span></div>
      <h2 id="response-title">My approach.</h2>
      <div class="response-grid">
        {caseStudy.response.map((item) => (
          <article data-reveal>
            <p>{item.label}</p>
            <h3>{item.title}</h3>
            <span>{item.body}</span>
          </article>
        ))}
      </div>
    </section>

    {caseStudy.screens && (
      <section class="case-screens" aria-labelledby="screens-title">
        <div class="case-section-label"><span>{sectionNumber("screens")} / Product</span><span>Select an image to enlarge</span></div>
        <h2 id="screens-title">In the product.</h2>
        <div class="screens-grid">
          {caseStudy.screens.map((screen) => (
            <figure data-reveal>
              <a href={screen.image.src} target="_blank" rel="noopener" aria-label={`Open full-size screenshot: ${screen.title}`}>
                <Image
                  src={screen.image}
                  alt={screen.alt}
                  widths={[640, 960, 1440]}
                  sizes="(max-width: 900px) 100vw, 50vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                <h3>{screen.title}</h3>
                <p>{screen.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {caseStudy.comparison && (
      <section class="case-comparison" aria-labelledby="comparison-title">
        <div class="case-section-label"><span>{sectionNumber("comparison")} / Evaluation</span><span>Before and after</span></div>
        <h2 id="comparison-title">{caseStudy.comparison.title}</h2>
        <p class="comparison-intro">{caseStudy.comparison.intro}</p>
        <table class="comparison-table" data-reveal>
          <thead>
            <tr><th scope="col">User message</th><th scope="col">Before</th><th scope="col">After</th></tr>
          </thead>
          <tbody>
            {caseStudy.comparison.rows.map((row) => (
              <tr>
                <th scope="row">{row.request}</th>
                <td data-label="Before">{row.before}</td>
                <td data-label="After">{row.after}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <section class="case-results" aria-labelledby="results-title">
      <div class="case-section-label"><span>{sectionNumber("results")} / Results</span><span>Results and limits</span></div>
      <div class="results-grid">
        <div data-reveal>
          <p class="eyebrow">Outcomes</p>
          <h2 id="results-title">What changed.</h2>
          <ol>
            {caseStudy.outcome.map((item, index) => (
              <li><span>0{index + 1}</span><p>{item}</p></li>
            ))}
          </ol>
        </div>
        <aside data-reveal>
          <p class="eyebrow">Scope</p>
          <h3>Details and limits.</h3>
          <ul>{caseStudy.boundaries.map((item) => <li>{item}</li>)}</ul>
        </aside>
      </div>
    </section>

    {caseStudy.reflection && (
      <section class="case-narrative" aria-labelledby="reflection-title" data-reveal>
        <div class="case-section-label"><span>{sectionNumber("reflection")} / Reflection</span><span>What I learned</span></div>
        <h2 id="reflection-title">{caseStudy.reflection.title}</h2>
        <div class="case-prose">
          {caseStudy.reflection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    <section class="next-case" aria-label="Next case study" data-reveal>
      <p>Next case / {nextCase.index}</p>
      <a href={`/work/${nextCase.slug}/`}>
        <span>{nextCase.shortTitle}</span>
        <strong>{nextCase.title}</strong>
        <i aria-hidden="true">↗</i>
      </a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
